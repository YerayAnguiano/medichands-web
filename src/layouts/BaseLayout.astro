---
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  hideHeaderFooter?: boolean;
  fullWidth?: boolean;
}

const {
  title = 'MedicHands — Plataforma de Divulgación y Triaje Mamario Continuo',
  description = 'Iniciativa de salud médica de la Universidad de Colima (UCol): monitoreo térmico continuo no invasivo con copas ergonómicas 3D en TPU y sensores de grado clínico.',
  image = '/images/og-medichands.jpg',
  type = 'website',
  hideHeaderFooter = false,
  fullWidth = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://medicommunity.vercel.app');
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Título y Descripción SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:site_name" content="MedicHands" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <!-- Google Fonts: Inter & Outfit -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@600;700;800;900&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-[#FEFEFE] text-[#1A1A1A] min-h-screen flex flex-col">
    <!-- Encabezado Sticky (si no está oculto) -->
    {!hideHeaderFooter && <Header />}

    <!-- Contenido Principal -->
    {fullWidth ? (
      <slot />
    ) : (
      <main class="flex-1 w-full max-w-6xl mx-auto px-4 sm:px-6 py-8">
        <slot />
      </main>
    )}

    <!-- Pie Editorial (si no está oculto) -->
    {!hideHeaderFooter && <Footer />}
  </body>
</html>

