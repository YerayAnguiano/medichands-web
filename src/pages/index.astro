---
import BaseLayout from '../layouts/BaseLayout.astro';
import FeaturedHero from '../components/home/FeaturedHero.astro';
import { PostFeed } from '../components/home/PostFeed';
import Sidebar from '../components/home/Sidebar.astro';
import { getPosts } from '../lib/supabase';

// Obtener publicaciones (desde Supabase con fallback a datos locales)
const allPosts = await getPosts();

// Ordenar por fecha descendente
const sortedPosts = [...allPosts].sort(
  (a, b) => new Date(b.publishedAt).getTime() - new Date(a.publishedAt).getTime()
);

// La publicación más reciente es automáticamente la destacada (Hero)
const featuredPost = sortedPosts[0];

// Las publicaciones restantes alimentan el feed secundario
const feedPosts = sortedPosts.slice(1);
---

<BaseLayout
  title="MedicHands — Blog de Divulgación y Triaje Mamario Continuo"
  description="Plataforma de divulgación de MedicHands (Universidad de Colima). Monitoreo térmico continuo, copas ergonómicas 3D en TPU y biosensores de grado clínico."
>
  <!-- Sección Destacada (Hero) -->
  {featuredPost && <FeaturedHero post={featuredPost} />}

  <!-- Cuerpo Principal: Feed y Columna Lateral -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    
    <!-- Columna Izquierda: Feed con Filtros y Buscador en Vivo (7 u 8 columnas) -->
    <div class="lg:col-span-8">
      <PostFeed client:load posts={sortedPosts} />
    </div>

    <!-- Columna Derecha: Sidebar Institucional (4 columnas) -->
    <div class="lg:col-span-4">
      <Sidebar />
    </div>

  </div>
</BaseLayout>
