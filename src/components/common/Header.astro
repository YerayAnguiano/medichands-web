---
// Header.astro - Encabezado sticky editorial inspirado en Substack / Retail Connect
---

<header class="sticky top-0 z-40 w-full bg-[#FEFEFE]/95 backdrop-blur-md border-b border-mh-lavender-light transition-all">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
    
    <!-- Lado Izquierdo: Marca / Logo -->
    <div class="flex items-center gap-3">
      <a href="/" class="flex items-center gap-2 group focus:outline-none" aria-label="Ir a inicio de MedicHands">
        <!-- Logo oficial de MedicHands -->
        <img src="/logo.ico" alt="Logo de MedicHands" class="w-8 h-8 sm:w-9 sm:h-9 object-contain group-hover:scale-105 transition-transform" />
        <span class="font-display font-black tracking-tight text-xl text-mh-primary hidden sm:inline-block">
          MedicHands
        </span>
      </a>
    </div>

    <!-- Centro en Mobile: Título para vista compacta -->
    <div class="sm:hidden font-display font-black text-lg text-mh-primary">
      MedicHands
    </div>

    <!-- Lado Derecho: Acciones y Acceso -->
    <div class="flex items-center gap-2 sm:gap-3">
      <!-- Botón de Búsqueda rápida -->
      <a
        href="#feed-section"
        class="p-2 text-mh-gray-700 hover:text-mh-primary hover:bg-mh-lavender-light rounded-full transition-colors"
        title="Buscar artículos"
        aria-label="Buscar artículos"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </a>

      <!-- Botón de Conoce Más (¿Quiénes somos?) -->
      <a
        href="/quienes-somos"
        class="text-sm font-semibold text-mh-gray-700 hover:text-mh-primary px-3 py-1.5 rounded-md hover:bg-mh-lavender-light transition-colors"
      >
        ¿Quiénes somos?
      </a>
    </div>

  </div>
</header>
