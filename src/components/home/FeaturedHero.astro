---
import type { Post } from '../../types';

interface Props {
  post: Post;
}

const { post } = Astro.props;

// Formatear fecha legible en español
const formattedDate = new Date(post.publishedAt).toLocaleDateString('es-MX', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<section class="mb-12">
  <div class="bg-[#FEFEFE] rounded-2xl border border-mh-lavender p-5 sm:p-7 shadow-sm hover:shadow-md transition-shadow">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      
      <!-- Columna Imagen: 7 columnas en desktop -->
      <div class="lg:col-span-7">
        <a href={`/post/${post.slug}`} class="block group overflow-hidden rounded-xl bg-mh-lavender-light aspect-[16/10] relative">
          <img
            src={post.coverImage}
            alt={post.title}
            class="w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-300"
            loading="eager"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/20 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
        </a>
      </div>

      <!-- Columna Texto: 5 columnas en desktop -->
      <div class="lg:col-span-5 flex flex-col justify-center">
        <!-- Badge y Fecha -->
        <div class="flex items-center gap-2 mb-3">
          <span class="inline-flex items-center text-xs font-bold uppercase tracking-wider px-2.5 py-0.5 rounded-full bg-mh-lavender text-mh-primary">
            {post.category}
          </span>
          <span class="text-xs font-medium text-mh-gray-500">
            {formattedDate}
          </span>
        </div>

        <!-- Título -->
        <h2 class="text-2xl sm:text-3xl font-display font-black text-mh-gray-900 leading-tight mb-3 group">
          <a href={`/post/${post.slug}`} class="hover:text-mh-primary transition-colors">
            {post.title}
          </a>
        </h2>

        <!-- Extracto -->
        <p class="text-sm sm:text-base text-mh-gray-700 leading-relaxed mb-6 line-clamp-3">
          {post.excerpt}
        </p>

        <!-- Autor y Detalles -->
        <div class="flex items-center justify-between pt-4 border-t border-mh-lavender-light text-xs text-mh-gray-500">
          <div class="flex items-center gap-2">
            <div class="w-6 h-6 rounded-full bg-mh-lavender-light border border-mh-lavender flex items-center justify-center font-bold text-mh-primary text-[10px]">
              {post.authorName.charAt(0)}
            </div>
            <span class="font-semibold text-mh-gray-700">{post.authorName}</span>
          </div>
          <div class="flex items-center gap-3">
            <span>{post.readingTimeMinutes} min de lectura</span>
            <span class="flex items-center gap-1 font-semibold text-mh-primary">
              <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
              {post.likesCount}
            </span>
          </div>
        </div>

      </div>

    </div>
  </div>
</section>
