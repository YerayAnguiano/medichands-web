# ==============================================================================
# VARIABLES DE ENTORNO — MEDICHANDS WEB (EJEMPLO)
# Duplicar este archivo como .env.local y asignar los valores de tu proyecto Supabase
# ==============================================================================

# URL base de tu proyecto en Supabase (ej. https://xyzcompany.supabase.co)
PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública anónima de Supabase (Project Settings -> API -> anon/public)
PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui
